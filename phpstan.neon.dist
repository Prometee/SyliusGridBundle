includes:
    - phpstan-baseline.neon

parameters:
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false

    level: max

    paths:
        - src

    excludePaths:
        - src/Bundle/Doctrine/PHPCRODM/*
        - src/Bundle/Resources/*
        - src/Bundle/spec/*
        - src/Bundle/Tests/*
        - src/Component/spec/*
        - src/Component/Tests/*
        - src/Component/vendor/*
